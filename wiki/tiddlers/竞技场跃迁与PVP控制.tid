title: 竞技场跃迁与PVP控制

本条目描述跃迁类技能在咏唱系统中的效果匹配方式。行动规则可以直接调用闪现、减速网、反跃迁等技能 id；技能源码中的咏唱代码提交签名链后，游戏运行时根据配方匹配对应游戏效果。

!! 闪现游戏效果配方

魔法书记载的闪现触发配方：

```ts
const blinkRecipe: SkillRecipe = {
  id: 'blink-mobility',
  skillId: 'blink',
  skillName: '闪现',
  optionalEffects: [
    {
      id: 'reducePreparation',
      repeat: 3,
      sequence: ['observer', 'pipeline', 'decorator'],
      constraints: {
        contiguous: true,
        distinctEventWindows: true,
        distinctDecoratorSlots: true,
      },
    },
    {
      id: 'increaseRange',
      repeat: 2,
      sequence: ['factoryMethod', 'pipeline', 'pipeline', 'decorator'],
      constraints: {
        distinctFactorySources: true,
        pipelineStepsMustDiffer: true,
      },
    },
    {
      id: 'reduceCooldown',
      repeat: 1,
      sequence: ['stateMachine', 'commandTrace', 'repository', 'decorator'],
      constraints: {
        stateMustAdvance: true,
        commandMustBeReplayable: true,
        repositoryMustUsePriorKnowledge: true,
      },
    },
  ],
};
```

!! 闪现咏唱示例

行动规则调用闪现技能后，技能源码中的咏唱代码生成签名链，并提交给游戏运行时匹配闪现效果：

```ts
export class BlinkSkill implements SkillDefinition<BlinkParams> {
  id = 'blink';
  description = '短距离空间跃迁';
  sourceRef = SourceRef.fromModule('skills/blink.ts');

  async execute(
    params: BlinkParams,
    context: SkillExecutionContext,
  ): Promise<SkillExecutionResult> {
    const strategy = new DistanceRouteStrategy(context.chant.rules);
    const source = new ArchiveVerseAdapter(context.chant.codex.archive);
    const collector = new MeterPulseCollector(context.chant.clock);
    const stateMachine = new StandardChantStateMachine();
    const pipeline = new StandardChantPipeline([
      new NormalizeFragmentStep(),
      new BindIndexRangeStep(),
      new FoldHexstoneStep(),
    ], context.chant);

    collector.subscribe('meterPulse');

    await stateMachine.transition('prepared', params);
    const route = strategy.choose(params);
    const fragment = await source.nextVerse(route.seed);

    await stateMachine.transition('collecting', { route, fragment });
    const pulse = await collector.waitFor('meterPulse');

    await stateMachine.transition('folding', { pulse });
    const bound = await pipeline.run({ fragment, pulse });

    await stateMachine.transition('sealed', { bound });

    const receipt = await context.finish.submit({
      skillId: this.id,
      paramsHash: hashParams(params),
      branchId: route.id,
      signatures: context.chant.codex.seal.collect({
        route,
        eventKeys: [pulse],
        pipelineTrace: bound.trace,
        stateTrace: stateMachine.trace(),
      }),
    });

    return { skillId: this.id, receipt };
  }
}
```

