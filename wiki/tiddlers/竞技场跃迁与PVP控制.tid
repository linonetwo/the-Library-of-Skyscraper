title: 竞技场跃迁与PVP控制

本条目描述跃迁类技能在咏唱系统中的触发方式。闪现、减速网、反跃迁都通过魔法书配方触发，玩家代码中没有直接调用这些技能的 API。

!! 闪现技能触发配方

魔法书记载的闪现触发配方：

```ts
const blinkRecipe: SkillRecipe = {
  id: 'blink-mobility',
  skillId: 'blink',
  skillName: '闪现',
  optionalEffects: [
    {
      id: 'reducePreparation',
      repeat: 3,
      sequence: ['observer', 'pipeline', 'decorator'],
      constraints: {
        contiguous: true,
        distinctEventWindows: true,
        distinctDecoratorSlots: true,
      },
    },
    {
      id: 'increaseRange',
      repeat: 2,
      sequence: ['factoryMethod', 'pipeline', 'pipeline', 'decorator'],
      constraints: {
        distinctFactorySources: true,
        pipelineStepsMustDiffer: true,
      },
    },
    {
      id: 'reduceCooldown',
      repeat: 1,
      sequence: ['stateMachine', 'commandTrace', 'repository', 'decorator'],
      constraints: {
        stateMustAdvance: true,
        commandMustBeReplayable: true,
        repositoryMustUsePriorKnowledge: true,
      },
    },
  ],
};
```

!! 闪现咏唱示例

玩家通过咏唱生成签名链，平台匹配配方后自动触发闪现：

```ts
export class BlinkChant implements ChantProgram<BlinkParams> {
  configure(container: ChantContainer): void {
    container.provide(TOKENS.routeStrategy, ctx =>
      new DistanceRouteStrategy(ctx.rules));
    container.provide(TOKENS.verseSource, ctx =>
      new ArchiveVerseAdapter(ctx.codex.archive));
    container.provide(TOKENS.pulseCollector, ctx =>
      new MeterPulseCollector(ctx.clock));
    container.provide(TOKENS.stateMachine, () =>
      new StandardChantStateMachine());
    container.provide(TOKENS.pipeline, ctx =>
      new StandardChantPipeline([
        new NormalizeFragmentStep(),
        new BindIndexRangeStep(),
        new FoldHexstoneStep(),
      ], ctx));
  }

  async run(params: BlinkParams, context: ChantContext): Promise<ChantProof> {
    const strategy = context.container.get(TOKENS.routeStrategy);
    const source = context.container.get(TOKENS.verseSource);
    const collector = context.container.get(TOKENS.pulseCollector);
    const stateMachine = context.container.get(TOKENS.stateMachine);
    const pipeline = context.container.get(TOKENS.pipeline);

    collector.subscribe('meterPulse');

    await stateMachine.transition('prepared', params);
    const route = strategy.choose(params);
    const fragment = await source.nextVerse(route.seed);

    await stateMachine.transition('collecting', { route, fragment });
    const pulse = await collector.waitFor('meterPulse');

    await stateMachine.transition('folding', { pulse });
    const bound = await pipeline.run({ fragment, pulse });

    await stateMachine.transition('sealed', { bound });

    return context.codex.seal.finalize({
      route,
      eventKeys: [pulse],
      pipelineTrace: bound.trace,
      stateTrace: stateMachine.trace(),
    });
  }
}
```

