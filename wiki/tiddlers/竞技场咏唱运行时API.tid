  | 'observer'
  | 'pipeline'
  | 'decorator'
  | 'stateMachine'
  | 'repository'
  | 'factoryMethod'
  | 'commandTrace'
  | 'adapter'
  | 'visitor'
  | 'strategy'
  | 'archive'
  | 'hexstone'
  | 'prayer'
  | 'index'
  | 'lattice'
  | 'artifact'
  | 'seal';

export interface ChantProcessRuntime {
  observer: ObserverRuntime;
  pipeline: PipelineRuntime;
  decorator: DecoratorRuntime;
  stateMachine: StateMachineRuntime;
  repository: RepositoryRuntime;
  factory: FactoryRuntime;
  command: CommandRuntime;
  adapter: AdapterRuntime;
  visitor: VisitorRuntime;
  strategy: StrategyRuntime;

  archive: ArchiveRuntime;
  hexstone: HexstoneRuntime;
  prayer: PrayerRuntime;
  index: IndexRuntime;
  lattice: LatticeRuntime;
  artifact: ArtifactRuntime;
  seal: SealRuntime;

  events: ChantEventRuntime;
  environment: ChantEnvironmentRuntime;
